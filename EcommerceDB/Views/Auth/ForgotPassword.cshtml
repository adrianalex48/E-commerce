@model EcommerceDB.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Restaurar contraseña";
}

<main class="container auth-page">
    <section class="auth-card">
        <p class="eyebrow">WIND<span class="highlight">BRANDS MX</span></p>
        <h1>Restaurar contraseña</h1>
        <p>Escribe el correo de tu cuenta para generar un enlace de recuperación.</p>
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Correo"></label>
                <input asp-for="Correo" class="form-control" autocomplete="email" autofocus />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>
            <button type="submit" class="btn-buy">Generar enlace</button>
        </form>
        @if (!string.IsNullOrWhiteSpace(Model.ResetUrl))
        {
            <div class="reset-link">
                <strong>Enlace de recuperación</strong>
                <a href="@Model.ResetUrl">Continuar para cambiar contraseña</a>
                <small>Este enlace vence en 30 minutos.</small>
            </div>
        }
        <p><a asp-action="Login">Volver a iniciar sesión</a></p>
    </section>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}