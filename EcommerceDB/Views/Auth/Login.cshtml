@model EcommerceDB.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<main class="container auth-page">
    <section class="auth-card">
        <p class="eyebrow">WIND<span class="highlight">BRANDS MX</span></p>
        <h1>Inicia sesión</h1>
        <p>Necesitas una cuenta para entrar a la tienda.</p>
        <form asp-action="Login" method="post">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Correo"></label>
                <input asp-for="Correo" class="form-control" autocomplete="email" autofocus />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password">Contraseña</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn-buy">Entrar</button>
        </form>
        @if (TempData["Mensaje"] != null)
        {
            <p class="auth-success">@TempData["Mensaje"]</p>
        }
        <p><a asp-action="ForgotPassword">¿Olvidaste tu contraseña?</a></p>
        <p>¿No tienes cuenta? <a asp-action="Register">Crea una aquí</a></p>
    </section>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}