@model EcommerceDB.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Nueva contraseña";
}

<main class="container auth-page">
    <section class="auth-card">
        <p class="eyebrow">WIND<span class="highlight">BRANDS MX</span></p>
        <h1>Elige una nueva contraseña</h1>
        <form asp-action="ResetPassword" method="post">
            <input asp-for="Correo" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Password">Nueva contraseña</label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" autofocus />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConfirmarPassword"></label>
                <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn-buy">Guardar contraseña</button>
        </form>
    </section>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}