@model CatalogoViewModel

@{
    ViewData["Title"] = "Catálogo";
}

<main class="container">
    <aside class="sidebar">
        <h3>Categorías</h3>
        <ul class="filter-list">
            @foreach (var cat in Model.Categorias)
            {
                <li><a asp-action="Index" asp-route-categoriaId="@cat.Id">@cat.Nombre</a></li>
            }
        </ul>

        @*
        <h3 class="mt-20">Tallas Disponibles</h3>
        <div class="size-grid">
            <button class="size-btn">US 7</button>
            <button class="size-btn">US 8</button>
            <button class="size-btn">US 9</button>
            <button class="size-btn">US 10</button>
            <button class="size-btn">US 11</button>
            <button class="size-btn">US 12</button>
        </div>

        <h3 class="mt-20">Marcas</h3>
        <ul class="filter-list">
            <li><a href="#">Nike</a></li>
            <li><a href="#">Adidas</a></li>
            <li><a href="#">Jordan</a></li>
            <li><a href="#">Puma</a></li>
            <li><a href="#">New Balance</a></li>
            <li><a href="#">ASICS</a></li>
        </ul>
        *@
    </aside>

    <section class="products-grid">
        @foreach (var product in Model.Productos)
        {
            <article class="product-card">
                <div class="image-container">
                    <img src="@product.ImagenUrl" alt="@product.Nombre" />
                </div>

                <div class="product-info">
                    <span class="badge">Categoria @product.Categoria.Nombre</span>
                    <span class="brand">Producto</span>
                    <h4 class="title">@product.Nombre</h4>

                    <div class="price-row">
                        <div class="lowest-ask">
                            <span class="label">Precio de venta</span>
                            <span class="price">$@product.PrecioVenta.ToString("N0") MXN</span>
                        </div>
                    </div>

                    <p class="stock-info">🟢 @product.Descripcion</p>
                    <button class="btn-buy">Comprar</button>
                </div>
            </article>
        }
    </section>
</main>