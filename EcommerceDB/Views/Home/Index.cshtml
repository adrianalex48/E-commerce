@model List<EcommerceDB.Models.Product>

@{
    ViewData["Title"] = "Catálogo";
}

<main class="container">
    <aside class="sidebar">
        <h3>Categorías</h3>
        <ul class="filter-list">
            <li><a href="#" class="active">Sneakers (Tenis)</a></li>
            <li><a href="#">Streetwear</a></li>
            <li><a href="#">Running</a></li>
            <li><a href="#">Lifestyle</a></li>
        </ul>

        <h3 class="mt-20">Tallas Disponibles</h3>
        <div class="size-grid">
            <button class="size-btn">US 7</button>
            <button class="size-btn">US 8</button>
            <button class="size-btn">US 9</button>
            <button class="size-btn">US 10</button>
            <button class="size-btn">US 11</button>
            <button class="size-btn">US 12</button>
        </div>
    </aside>

    <section class="products-grid">
        @foreach (var product in Model)
        {
            <article class="product-card">
                <div class="image-container">
                    <img src="@product.ImageUrl" alt="@product.Name" />
                </div>

                <div class="product-info">
                    <span class="badge">@product.Badge</span>
                    <span class="brand">@product.Brand</span>
                    <h4 class="title">@product.Name</h4>

                    <div class="price-row">
                        <div class="lowest-ask">
                            <span class="label">Precio más bajo</span>
                            <span class="price">$@product.Price.ToString("N0") MXN</span>
                        </div>
                    </div>

                    <p class="stock-info">🟢 @product.StockText</p>
                    <button class="btn-buy">Comprar</button>
                </div>
            </article>
        }
    </section>
</main>