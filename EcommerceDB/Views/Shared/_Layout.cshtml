<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WindbrandsMX</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <!-- Conectamos el CSS que acabas de guardar -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
</head>
<body>
    <!-- El Menú Superior siempre será visible -->
    <header class="navbar">
        <a asp-controller="Home" asp-action="Index" class="logo-container" aria-label="Ir al inicio">
            <img src="~/images/logo-windbrands.png" alt="Windbrands MX Logo" class="brand-logo" />
            <span class="logo">&nbsp;&nbsp;WIND<span class="highlight">BRANDS MX</span></span>
        </a>
        <form class="search-container" asp-controller="Home" asp-action="Index" method="get">
            <input type="text" class="search-bar" name="busqueda" placeholder="Buscar tenis, ropa y más..." value="@ViewBag.BusquedaActual">
            <button type="submit" style="border: none; background: none; cursor: pointer; padding: 0;">
                <img src="~/images/mortygc.png" alt="Buscar" class="search-decoration" />
            </button>
        </form>
        <div class="header-actions">
            <div class="location-selector">
                <span class="icon">📍</span> Envío a: <strong>Casa</strong> | Desde: <strong>Bodega Central</strong>
            </div>
            <div class="cart">
                <span class="icon">🛒</span> <span class="cart-count">2</span>
            </div>
            @if (Context.Session.GetInt32("ClienteId") != null)
            {
                <span>Hola, @Context.Session.GetString("ClienteNombre")</span>
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    <button type="submit" class="btn-buy">Salir</button>
                </form>
            }
        </div>
    </header>

    <!-- Menú de Categorías Principal -->
    <nav class="category-menu">
        <div class="container-nav">
            @if (ViewBag.Categorias != null)
            {
                foreach (var cat in ViewBag.Categorias)
                {
                    <a asp-controller="Home" asp-action="Index" asp-route-categoriaId="@cat.Id" class="category-link">@cat.Nombre</a>
                }
            }
        </div>
    </nav>

    <!-- Aquí Visual Studio inyectará el contenido de las otras páginas -->
    @RenderBody()

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>